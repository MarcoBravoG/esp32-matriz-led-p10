/*
  ============================================================
   HOLA MUNDO en matriz LED P10 (32x16) con ESP32 - SIN LIBRERIAS
  ============================================================
   CONEXION (conector HUB12 de ENTRADA del P10 -> ESP32)
     OE  -> GPIO 22     A   -> GPIO 19     B -> GPIO 21
     CLK -> GPIO 18     LAT -> GPIO 2      R -> GPIO 23
     GND -> GND (unido tambien al GND de la fuente de 5V)
  ============================================================
   1) Muestra "Hola" / "Mundo" fijo durante 3 segundos
   2) Desplaza "Hola Mundo" en letra grande
  ============================================================
*/

#define OE  22
#define A   19
#define B   21
#define CLK 18
#define LAT 2
#define R   23

const char *MENSAJE = "Hola Mundo";
const int VELOCIDAD = 40;      // ms por paso (menor = mas rapido)
const int TIEMPO_FIJO = 3000;  // ms del texto fijo
const int BRILLO_US = 800;     // tiempo por fila en microsegundos

